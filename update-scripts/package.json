{
  "name": "osu-pps-update-scripts",
  "version": "2.0.0",
  "description": "Scripts that fetch osu! data and build the data files for the osu-pps web UI",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/scheduler.ts",
    "start:debug": "node src/scheduler.ts --debug --no-push",
    "update-mode": "node src/run-mode.ts",
    "push:r2": "node src/push-r2.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --test tests/*.test.ts",
    "test:coverage": "node --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-exclude=tests/** tests/*.test.ts"
  },
  "keywords": [
    "osu",
    "pp",
    "pps"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@discoveryjs/json-ext": "^1.1.0",
    "axios": "^1.17.0",
    "node-schedule": "^2.1.1",
    "papaparse": "^5.5.2"
  },
  "author": "grumd",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-schedule": "^2.1.7",
    "@types/papaparse": "^5.3.15",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24"
  }
}
